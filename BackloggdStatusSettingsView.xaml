<UserControl x:Class="BackloggdStatus.BackloggdStatusSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:BackloggdStatus"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="StatusMappingActionValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:StatusMappingAction"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="TriStateValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:TriState"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="PlayedTargetStateValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:PlayedTargetState"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <!-- ── Account ──────────────────────────────────────────────── -->
            <GroupBox Header="Account" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Signed in as: " VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Username}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Sign In"
                                Width="80"
                                Margin="0,0,8,0"
                                Click="SignIn_Click"/>
                        <Button Content="Sign Out"
                                Width="80"
                                Click="SignOut_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ── Mapped Games ─────────────────────────────────────────── -->
            <GroupBox Header="Mapped Games" Margin="0,0,0,12">
                <DataGrid ItemsSource="{Binding MappedGames}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          MinHeight="120"
                          MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Playnite Game"
                                            Binding="{Binding PlayniteName}"
                                            IsReadOnly="True"
                                            Width="*"/>
                        <DataGridTextColumn Header="Backloggd Title"
                                            Binding="{Binding BackloggdName}"
                                            IsReadOnly="True"
                                            Width="*"/>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding StatusSummary}"
                                            IsReadOnly="True"
                                            Width="130"/>
                        <DataGridTextColumn Header="Last Synced"
                                            Binding="{Binding LastSyncedDisplay}"
                                            IsReadOnly="True"
                                            Width="120"/>
                        <DataGridTemplateColumn Header="" Width="60" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Unlink"
                                            Tag="{Binding GameId}"
                                            Click="Unlink_Click"
                                            Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- ── Status Mapping ───────────────────────────────────────── -->
            <GroupBox Header="Status Mapping" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <TextBlock Text="Configure what each dimension should become on Backloggd when a game's Completion Status changes. Leave a column as &quot;Unchanged&quot; to leave that dimension alone."
                               TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8"/>
                    <CheckBox Content="Automatically apply mappings when Completion Status changes"
                              IsChecked="{Binding Settings.AutoApplyStatusMappings}"
                              Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding StatusMappingRows}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              MinHeight="100"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Playnite Completion Status"
                                                Binding="{Binding CompletionStatusName}"
                                                IsReadOnly="True"
                                                Width="*"/>
                            <DataGridTemplateColumn Header="Playing" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource TriStateValues}}"
                                                  SelectedItem="{Binding Playing, Mode=OneWay}"
                                                  Tag="Playing"
                                                  SelectionChanged="TriState_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Backlog" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource TriStateValues}}"
                                                  SelectedItem="{Binding Backlog, Mode=OneWay}"
                                                  Tag="Backlog"
                                                  SelectionChanged="TriState_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Wishlist" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource TriStateValues}}"
                                                  SelectedItem="{Binding Wishlist, Mode=OneWay}"
                                                  Tag="Wishlist"
                                                  SelectionChanged="TriState_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Played" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource PlayedTargetStateValues}}"
                                                  SelectedItem="{Binding Played, Mode=OneWay}"
                                                  SelectionChanged="PlayedTarget_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Apply Mappings Now"
                            Width="140"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Click="ApplyStatusMappings_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Pull from Backloggd ──────────────────────────────────── -->
            <GroupBox Header="Pull from Backloggd" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <TextBlock Text="Set a game's Playnite Completion Status based on its current Backloggd status. Rows left as &quot;(No change)&quot; are ignored."
                               TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding PullStatusMappingRows}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              MinHeight="100"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Backloggd Status"
                                                Binding="{Binding BackloggdSourceStatus}"
                                                IsReadOnly="True"
                                                Width="*"/>
                            <DataGridTemplateColumn Header="Playnite Completion Status" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableCompletionStatuses, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding TargetCompletionStatusId, Mode=OneWay}"
                                                  SelectionChanged="PullMappingTarget_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Pull from Backloggd Now"
                            Width="160"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Click="PullFromBackloggd_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Sync Options ─────────────────────────────────────────── -->
            <GroupBox Header="Sync Options" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <CheckBox Content="Sync status on Playnite startup"
                              IsChecked="{Binding Settings.SyncOnStartup}"
                              Margin="0,0,0,8"/>
                    <Button Content="Sync All Now"
                            Width="100"
                            HorizontalAlignment="Left"
                            Click="SyncAll_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Debug / Diagnostics ──────────────────────────────────── -->
            <GroupBox Header="Debug / Diagnostics">
                <StackPanel Margin="8">
                    <CheckBox Content="Enable debug logging"
                              IsChecked="{Binding Settings.IsDebugMode}"
                              Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Plugin data folder: "
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LogFilePath}"
                                   VerticalAlignment="Center"
                                   Opacity="0.7"
                                   Margin="4,0,8,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="300"/>
                        <Button Content="Open Folder"
                                Width="90"
                                Click="OpenLog_Click"/>
                    </StackPanel>
                    <Button Content="Collect Diagnostics"
                            Width="150"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,4"
                            Click="CollectDiagnostics_Click"/>
                    <Button x:Name="RunTestsButton"
                            Content="Run Integration Tests"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="RunTestsButton_Click"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
