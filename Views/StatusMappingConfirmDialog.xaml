<Window x:Class="BackloggdStatus.Views.StatusMappingConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Status Mapping"
        Background="White"
        Height="480" Width="640"
        MinHeight="300" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Foreground="Black"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyText"
                       Text="Nothing to apply — no games currently match a configured mapping."
                       Foreground="Black"
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       VerticalAlignment="Top"
                       Visibility="Collapsed"/>

            <DataGrid x:Name="RowsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="White">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFEFEFEF"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColGameName" Binding="{Binding GameName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColCurrentStatus" Binding="{Binding CurrentStatus}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColNewStatus" Binding="{Binding NewStatus}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    Content="Cancel"
                    Width="80"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button x:Name="ApplyButton"
                    DockPanel.Dock="Right"
                    Content="Apply"
                    Width="80"
                    IsDefault="True"
                    Click="Apply_Click"/>
        </DockPanel>
    </Grid>
</Window>
